  m_TableData:
  - m_Id: 111713996800
    m_Localized: <anim:wave><color=yellow>Willkommen im neuen Kapitel!</color></anim>.
      Hier dreht sich alles um deinen ersten Prozessor - den Eintaktprozessor.
    m_Metadata:
      m_Items: []
  - m_Id: 140197515264
    m_Localized: "Leider sind die Dialoge f\xFCr dieses Kapitel noch nicht ganz fertig
      :(\\nAber keine Sorge, ich arbeite bereits flei\xDFig daran !"
    m_Metadata:
      m_Items: []
  - m_Id: 150624555008
    m_Localized: "Das Gute ist: Alle Level des Kapitels sind bereits spielbar und
      l\xF6sbar. Aktuell musst du nur leider noch ohne Hinweise und Erkl\xE4rungen
      auskommen."
    m_Metadata:
      m_Items: []
  - m_Id: 160497946624
    m_Localized: "Im Kapitel \"Mehrtaktprozessor\" ist daf\xFCr schon alles komplett
      fertig!"
    m_Metadata:
      m_Items: []
  - m_Id: 2183191941894144
    m_Localized: Bearbeite den Wert aus Instruction Memory an die Adresse 0 korrekt.
    m_Metadata:
      m_Items: []
